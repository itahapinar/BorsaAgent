# SABLON — buraya GERCEK ANAHTAR YAZMA, bu dosya git'te takip ediliyor.
# Gercek degerler .env dosyasina yazilir (.gitignore'da).

# --- Asama 1 (MCP sunucusu) ---
# evds2.tcmb.gov.tr uzerinden ucretsiz alinir
EVDS_API_KEY=
LOG_LEVEL=INFO

# --- Asama 2 (Telegram ajani) ---
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# build.nvidia.com -> API anahtari, "nvapi-" ile baslar
NVIDIA_API_KEY=
# Bos birakilirsa model_karsilastir.py ile secilen model yazilir
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# @userinfobot sana soyler. Bot YALNIZ bu kullaniciya cevap verir.
ADMIN_USER_ID=
